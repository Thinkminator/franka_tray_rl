-    # 1) Vectorized envs
-    make_env = make_env_fn(
-        model_path="assets/panda_tray/panda_tray_cylinder.xml",
-        config_path="envs/traypose/config.yaml",
-        obs_noise_std_pos=0.0,
-        obs_noise_std_vel=0.0,
