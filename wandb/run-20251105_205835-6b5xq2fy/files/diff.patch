-def main():
-    # Initialize Weights & Biases
-    import wandb
-    wandb.init(
-        project="franka_tray_rl",
-        sync_tensorboard=True,
-        config={
-            "n_envs": 8,
-            "n_steps": 1024,
-            "batch_size": 256,
-            "total_timesteps": 1_000_000,
-            "learning_rate": 1e-4,
-            "gamma": 0.99,
